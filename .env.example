OPENAI_KEY=""
TELEGRAM_BOT_KEY=""
TELEGRAM_CHAT_ID=""

# CoachAI Vôlei web app
# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SESSION_SECRET="change-this-to-a-long-random-string"

# Hotmart purchase gate (optional). If any of these are missing, the app
# lets everyone through (fails open) — nothing is blocked until all four
# are set. Generate the credentials in Hotmart > Ferramentas > Credenciais.
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
HOTMART_BASIC_TOKEN=""

# One or more Hotmart product IDs, comma-separated. A purchase of ANY of
# these products grants access (e.g. two different offers/plans for the
# same app). Find each product's ID in Hotmart > Produtos > (seu produto).
HOTMART_PRODUCT_IDS="123456,789012"

# Comma-separated emails that always pass the purchase check, regardless of
# Hotmart status (useful for your own testing/admin access).
HOTMART_ALLOWLIST_EMAILS=""
